{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/birthdays",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/backup-verify",
      "schedule": "30 4 * * 0"
    },
    {
      "path": "/api/cron/asaas-reconcile",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/trail-reminders",
      "schedule": "30 9 * * *"
    }
  ]
}
