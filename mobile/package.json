{
  "name": "mais-trilha-operacoes",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "build:participant:android": "cross-env APP_VARIANT=participant eas build --platform android --profile preview",
    "build:guide:android": "cross-env APP_VARIANT=guide eas build --platform android --profile guide-preview",
    "build:participant:ios": "cross-env APP_VARIANT=participant eas build --platform ios --profile production",
    "build:guide:ios": "cross-env APP_VARIANT=guide eas build --platform ios --profile guide-production"
  },
  "dependencies": {
    "@maistrilha/trail-core": "file:../packages/trail-core",
    "@maplibre/maplibre-react-native": "11.3.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-battery": "~57.0.0",
    "expo-camera": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-location": "~57.0.2",
    "expo-network": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
