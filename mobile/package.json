{
  "name": "mais-trilha-operacoes",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "cross-env APP_VARIANT=participant expo start -c",
    "start:participant": "cross-env APP_VARIANT=participant expo start -c",
    "start:go": "cross-env EXPO_GO=1 expo start -c",
    "start:guide": "cross-env APP_VARIANT=guide EXPO_GO=1 expo start -c",
    "start:guide:web": "cross-env APP_VARIANT=guide EXPO_GO=1 expo start --web --port 8083 -c",
    "export:guide:web": "cross-env APP_VARIANT=guide expo export --platform web --output-dir dist/guide-web --clear",
    "serve:guide:web": "npx serve dist/guide-web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "build:participant:android": "cross-env APP_VARIANT=participant eas build --platform android --profile preview --non-interactive",
    "build:guide:android": "cross-env APP_VARIANT=guide eas build --platform android --profile guide-preview --non-interactive",
    "build:participant:ios": "cross-env APP_VARIANT=participant eas build --platform ios --profile production",
    "build:guide:ios": "cross-env APP_VARIANT=guide eas build --platform ios --profile guide-production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.0.2",
    "@maistrilha/trail-core": "file:../packages/trail-core",
    "@maplibre/maplibre-react-native": "11.3.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-battery": "~57.0.0",
    "expo-camera": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.5",
    "expo-image-picker": "~57.0.5",
    "expo-location": "~57.0.2",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.6",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.6",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.0",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
