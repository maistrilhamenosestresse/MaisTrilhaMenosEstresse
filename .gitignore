# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/

# Documentos gerados e estratégias internas ficam somente no computador
/output/
/scripts/generate-admin-manual-pdf.py
/scripts/generate-sales-funnel-strategy-pdf.py
/scripts/qa-admin-manual-pdf.py
/scripts/qa-sales-funnel-strategy-pdf.py

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server*.log
/.logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Protótipo do Passaporte mantido somente neste computador (não publicar)
/src/app/app/passaporte/
/src/app/api/app/passport/
/src/lib/passport-share.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Backups devem existir somente no S3 criptografado
/backups/
backup_*.json
*.dump
.media-migration-complete.json
/create_test_user.js

.vercel
